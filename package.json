{
  "name": "hlo-prettier",
  "displayName": "HLO Prettier",
  "description": "Syntax highlighting and editor support for XLA HLO text files.",
  "version": "0.0.1",
  "publisher": "5yearsKim",
  "icon": "images/icon.png",
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:hlo"
  ],
  "author": {
    "name": "OnionKim",
    "url": "https://github.com/5yearsKim"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/5yearsKim/HLOPrettier.git"
  },
  "homepage": "https://github.com/5yearsKim/HLOPrettier#readme",
  "bugs": {
    "url": "https://github.com/5yearsKim/HLOPrettier/issues"
  },
  "files": [
    "language-configuration.json",
    "syntaxes/**/*.json",
    "dist/extension.js",
    "images/icon.png",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=22",
    "vscode": "^1.85.0"
  },
  "scripts": {
    "build": "node ./scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "validate": "node ./scripts/check-json.mjs",
    "test": "node --test ./test/*.test.mjs",
    "vscode:prepublish": "pnpm run build",
    "package": "pnpm run validate && pnpm run typecheck && pnpm test && vsce package"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "hlo",
    "xla",
    "openxla",
    "compiler",
    "prettier",
    "syntax-highlighting"
  ],
  "contributes": {
    "languages": [
      {
        "id": "hlo",
        "aliases": [
          "HLO",
          "hlo"
        ],
        "extensions": [
          ".hlo"
        ],
        "filenamePatterns": [
          "module_*.jit_*.txt",
          "*before_optimizations.txt",
          "*.cpu_after_optimizations.txt",
          "*.gpu_after_optimizations.txt"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "hlo",
        "scopeName": "source.hlo",
        "path": "./syntaxes/hlo.tmLanguage.json"
      }
    ]
  },
  "devDependencies": {
    "@types/vscode": "1.85.0",
    "@vscode/vsce": "3.9.2",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vscode-oniguruma": "2.0.1",
    "vscode-textmate": "9.3.2"
  }
}
