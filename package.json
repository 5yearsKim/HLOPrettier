{
  "name": "hlo-prettier",
  "displayName": "HLO Prettier",
  "description": "Syntax highlighting and configurable document formatting for XLA HLO text files.",
  "version": "0.1.0",
  "publisher": "5yearsKim",
  "icon": "images/icon.png",
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:hlo"
  ],
  "author": {
    "name": "OnionKim",
    "url": "https://github.com/5yearsKim"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/5yearsKim/HLOPrettier.git"
  },
  "homepage": "https://github.com/5yearsKim/HLOPrettier#readme",
  "bugs": {
    "url": "https://github.com/5yearsKim/HLOPrettier/issues"
  },
  "files": [
    "language-configuration.json",
    "syntaxes/**/*.json",
    "dist/extension.js",
    "images/icon.png",
    "images/hlo-light.png",
    "images/hlo-dark.png",
    "images/hlo_highlight.png",
    "images/hlo_pretty_format.gif",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE"
  ],
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=22",
    "vscode": "^1.85.0"
  },
  "scripts": {
    "build": "node ./scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "validate": "node ./scripts/check-json.mjs",
    "test": "node --import tsx --test ./test/*.test.mjs",
    "vscode:prepublish": "pnpm run build",
    "package": "pnpm run validate && pnpm run typecheck && pnpm test && vsce package"
  },
  "categories": [
    "Programming Languages",
    "Formatters"
  ],
  "keywords": [
    "hlo",
    "xla",
    "openxla",
    "compiler",
    "formatter",
    "prettier",
    "syntax-highlighting"
  ],
  "contributes": {
    "languages": [
      {
        "id": "hlo",
        "aliases": [
          "HLO",
          "hlo"
        ],
        "extensions": [
          ".hlo"
        ],
        "filenamePatterns": [
          "module_*.jit_*.txt",
          "*before_optimizations.txt",
          "*.cpu_after_optimizations.txt",
          "*.gpu_after_optimizations.txt"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./images/hlo-light.png",
          "dark": "./images/hlo-dark.png"
        }
      }
    ],
    "grammars": [
      {
        "language": "hlo",
        "scopeName": "source.hlo",
        "path": "./syntaxes/hlo.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "HLO Prettier",
      "type": "object",
      "properties": {
        "hloPrettier.printWidth": {
          "type": "integer",
          "default": 120,
          "minimum": 40,
          "maximum": 500,
          "scope": "language-overridable",
          "description": "Preferred maximum line width when formatting HLO."
        },
        "hloPrettier.attributeWrapping": {
          "type": "string",
          "enum": [
            "auto",
            "preserve",
            "onePerLine"
          ],
          "default": "auto",
          "scope": "language-overridable",
          "description": "Controls how trailing instruction attributes are wrapped."
        },
        "hloPrettier.formatMetadata": {
          "type": "boolean",
          "default": false,
          "scope": "language-overridable",
          "description": "Controls whether metadata objects may be reformatted."
        },
        "hloPrettier.blankLinesBetweenComputations": {
          "type": "integer",
          "default": 1,
          "minimum": 0,
          "maximum": 2,
          "scope": "language-overridable",
          "description": "Number of blank lines between computation blocks."
        }
      }
    }
  },
  "devDependencies": {
    "@types/vscode": "1.85.0",
    "@vscode/vsce": "3.9.2",
    "esbuild": "0.28.2",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vscode-oniguruma": "2.0.1",
    "vscode-textmate": "9.3.2"
  }
}
