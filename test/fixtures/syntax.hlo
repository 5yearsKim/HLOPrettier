/* Block comments can
   continue across lines. */
HloModule syntax_coverage

ENTRY %main (input: f32[?,<=128]) -> f32[?,<=128]{1,0:T(8,128)(2,1)S(5)} {
  // Single-quoted strings use the same C-style escaping rules.
  %input = f32[?,<=128]{1,0:T(8,128)(2,1)S(5)} parameter(0), metadata={op_name='input\nvalue'}
  ROOT %output = f32[?,<=128]{1,0:T(8,128)(2,1)S(5)} copy(%input)
}

// Standalone lexer punctuation coverage: * # ~ + ...
* # ~ + ...
